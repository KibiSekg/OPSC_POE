<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F4F1EC">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#BCC8CC"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Add New Category"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#15174D"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Category Name"
        android:layout_marginBottom="24dp"
        app:boxStrokeColor="#15174D"
        app:hintTextColor="#15174D">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="#15174D" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBottomSheetAdd"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Create Category"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="25dp"
        android:backgroundTint="#ED4B00"
        android:textColor="#F4F1EC" />

</LinearLayout>